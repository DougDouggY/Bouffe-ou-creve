{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bouffeoucrevemulti",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PrivateRoom" }],
  },
  "migrations": [
    { "tag": "v1-private-rooms", "new_sqlite_classes": ["PrivateRoom"] },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://dougdouggy.github.io,http://127.0.0.1:8000,http://localhost:8000",
  },
  "observability": { "enabled": false },
}
